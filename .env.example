# ══════════════════════════════════════════════════════════════
# MontxBOT — configuração de ambiente
# Copie este arquivo para .env e preencha o que quiser.
# TUDO aqui é OPCIONAL: o bot funciona sem nenhuma chave,
# usando serviços gratuitos (Pollinations, TikWM, scrapers, Open-Meteo,
# Frankfurter e Nager.Date). As novas APIs de utilidade não precisam de chave.
# ══════════════════════════════════════════════════════════════

# ── SEU NÚMERO / DONO ──────────────────────────────────────────
# Números que são donos do bot (DDI+DDD, só dígitos, separados por vírgula).
# Se vazio, o dono é a própria conta conectada.
OWNER_NUMBERS=

# Número para pareamento por código (Termux usa sempre este modo).
# Também pode salvar com: npm run pair -- 5511999999999
PAIRING_NUMBER=

# ── REMOÇÃO DE FUNDO ─────────────────────────────────────────
# Credenciais próprias. O pool respeita limites e cooldowns do provedor;
# várias chaves não tornam cotas ilimitadas nem devem contornar políticas.
#
# IMPORTANTE: este arquivo tem que se chamar .env e ficar NA RAIZ do bot
# (a mesma pasta do package.json). O bot lê ele só na INICIALIZAÇÃO —
# depois de colar as chaves, reinicie (./bot.sh start) e confira com .pools.
REMOVE_BG_KEYS=

# APIs próprias/alternativas de remoção de fundo (POST multipart, campo "image",
# resposta PNG). O operador confia nesses endpoints, inclusive se forem locais;
# use apenas serviços que você administra. Separe por vírgula para redundância.
REMOVE_BG_URLS=

# Usa o `rembg` local (pip install rembg) como último recurso: true/false
LOCAL_REMBG=false

# ── IA (opcional — prompts podem ser enviados ao provedor escolhido) ──
# Chaves Gemini (aistudio.google.com — grátis): gira entre várias
GEMINI_KEYS=
# Chaves OpenAI
OPENAI_KEYS=
#
# ── GROQ: VÁRIAS CHAVES DO MESMO PROVEDOR ─────────────────────────────
# Chaves Groq (console.groq.com — grátis e rápido).
# Você pode colocar QUANTAS chaves quiser de três formas (ou misturando):
#
#   1) todas na mesma linha, separadas por vírgula ou espaço:
#        GROQ_KEYS=gsk_aaaaaa,gsk_bbbbbb,gsk_cccccc
#
#   2) uma por variável (aceita GROQ_API_KEY e GROQ_KEY):
#        GROQ_API_KEY=gsk_aaaaaa
#        GROQ_KEY=gsk_bbbbbb
#
#   3) numeradas (vão até _12):
#        GROQ_KEY_1=gsk_aaaaaa
#        GROQ_KEY_2=gsk_bbbbbb
#        GROQ_KEY_3=gsk_cccccc
#
# Todas entram no MESMO pool e giram em rodízio: quando uma estoura o limite,
# a próxima assume na hora. Respeitamos os limites e cooldowns informados pela
# Groq — pools não tornam a cota ilimitada nem devem contornar as regras do
# provedor. Confira com .pools — ou use .pools recarregar para reler este
# arquivo sem reiniciar o bot.
GROQ_KEYS=
#
# Modelos Groq, em ordem de preferência (opcional).
# Se o primeiro der erro, o bot tenta o próximo COM A MESMA CHAVE.
# Motivo: provedores descontinuam modelos o tempo todo — a Groq desligou
# llama-3.3-70b-versatile em 16/08/2026 e ele passou a devolver
# "HTTP 404 … model does not exist". Girar a chave não resolvia nada ali;
# o que resolve é tentar outro modelo. Se todos falharem, o bot ainda
# consulta GET /models e usa um modelo que exista hoje.
# Padrão (quando vazio): openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b,qwen/qwen3.6-27b
GROQ_MODELS=
#
# Qualquer API compatível com OpenAI (OpenRouter, DeepSeek, Ollama…)
# Credenciais serão enviadas a este endpoint; use somente serviço confiável.
AI_BASE_URL=
AI_KEYS=
AI_MODEL=
# Modelos para a API customizada acima, em ordem de preferência (opcional)
AI_MODELS=
# Modelos Gemini/OpenAI em ordem de preferência (opcional).
# O padrão do Gemini é gemini-3.8-flash com reservas, porque gemini-2.0-flash
# foi desligado pelo Google em 01/06/2026.
GEMINI_MODELS=
OPENAI_MODELS=
# Pollinations (opcional; também pode operar sem chave)
POLLINATIONS_KEYS=
#
# ── IMAGEM (.criar) ───────────────────────────────────────────────────
# Nada aqui é obrigatório: sem chave nenhuma o bot gera imagem pelo
# Pollinations, de graça. Com chave, a qualidade sobe (o prompt é refinado
# antes de desenhar e o motor melhora).
#
# Modelo padrão do Pollinations (o serviço muda a lista com o tempo; o bot
# descobre os disponíveis sozinho e cai para o próximo quando um sai do ar).
# Padrão: flux → turbo → kontext → sana
IMAGE_MODEL=
# Lista própria, em ordem de preferência (opcional)
IMAGE_MODELS=
# Modelos de imagem do Gemini, em ordem (opcional). Usados só se houver
# GEMINI_KEYS. O bot também descobre sozinho quais geram imagem.
GEMINI_IMAGE_MODELS=
#
# ── VOZ (.voz) ────────────────────────────────────────────────────────
# A voz principal é GRÁTIS, sem chave e sem cadastro (motor Edge/"Ler em voz
# alta"). Não precisa configurar nada para usar .voz, .vozes e .vozpadrao.
#
# 1) VOZES SUAS: crie quantas quiser no formato
#      nome=voz|pitch=+30|rate=+5|fx=nasal+ecoCurto|desc=o que eu quiser
#    - pitch  = tom (+ sobe, - desce), em %
#    - rate   = velocidade, em %
#    - fx     = efeitos: nasal, grave, meioGrave, brilho, vibrato, vibratoLeve,
#               ecoCurto, ecoLongo, ecoFantasma, robotico, radio, teatro,
#               sussurro, distorcao
#    - desc   = descrição que aparece no .vozes
#    Exemplos:
#      VOZES_EXTRA=meuvoz=pt-BR-ThalitaNeural|pitch=+25|rate=+10|fx=nasal
#      VOZES_EXTRA=tio=pt-BR-AntonioNeural|pitch=-10|rate=-6|fx=radio
#    Também vale apontar para outro motor:
#      VOZES_EXTRA=homer=eleven:<voiceId>|fx=grave   (precisa de ELEVENLABS_KEYS)
#      VOZES_EXTRA=robo2=polly:Camila|fx=robotico
VOZES_EXTRA=
#
# 2) OPICIONAL — ElevenLabs (vozes de personagem reais, plano grátis próprio):
#    é a única forma de ter vozes licenciadas de verdade no catálogo.
ELEVENLABS_KEYS=
# Voz padrão do ElevenLabs quando o catálogo não indicar uma (padrão: "Rachel")
ELEVENLABS_VOICE_ID=

# ── ⬇️ DOWNLOADS ───────────────────────────────────────────────
# O bot já baixa TikTok, Instagram, Pinterest, YouTube, X, Facebook,
# Threads, Reddit, Twitch e Vimeo SEM configurar nada. As opções abaixo
# só afinam o desempenho.
#
# Instâncias Cobalt (serviço externo para a cauda longa de sites).
# Use apenas endpoints confiáveis. Instâncias customizadas podem ser locais.
# Lista pública: https://instances.cobalt.best
COBALT_INSTANCES=
# Chave para instância Cobalt PRÓPRIA (auto-hospedada)
COBALT_API_KEY=

# Endpoints alternativos do TikTok (padrão: tikwm.com)
TIKTOK_API=

# yt-dlp local (opcional). No Termux: pip install -U yt-dlp
# Por segurança, o bot NÃO executa yt-dlp automaticamente: o binário segue
# redirecionamentos próprios que não passam pelo validador HTTP do bot.
# Habilite apenas se confiar nos links usados e na configuração de rede local.
# Deixe YTDLP_PATH vazio para autodetecção, se habilitar.
YTDLP_PATH=
NEXUS_ENABLE_YTDLP=false
# Desligamento de emergência (mantido como override): true/false
NEXUS_DISABLE_YTDLP=false

# ── AVANÇADO ───────────────────────────────────────────────────
# Força uma versão específica do WhatsApp Web (ex.: 2,3000,1015901307)
WA_VERSION_OVERRIDE=
