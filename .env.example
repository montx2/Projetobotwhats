# ══════════════════════════════════════════════════════════════
# ⚡ NEXUS BOT — configuração de ambiente
# Copie este arquivo para .env e preencha o que quiser.
# TUDO aqui é OPCIONAL: o bot funciona sem nenhuma chave,
# usando as APIs gratuitas (Pollinations, TikWM, scrapers).
# ══════════════════════════════════════════════════════════════

# ── SEU NÚMERO / DONO ──────────────────────────────────────────
# Números que são donos do bot (DDI+DDD, só dígitos, separados por vírgula).
# Se vazio, o dono é a própria conta conectada.
OWNER_NUMBERS=

# Número para pareamento por código (Termux usa sempre este modo).
# Também pode salvar com: npm run pair -- 5511999999999
PAIRING_NUMBER=

# ── 🎭 REMOÇÃO DE FUNDO (pool de contas = uso ilimitado) ─────
# Crie várias contas grátis em https://www.remove.bg/api e cole
# as chaves separadas por vírgula. O bot gira entre elas e pula
# automaticamente a que estourar o limite.
#
# IMPORTANTE: este arquivo tem que se chamar .env e ficar NA RAIZ do bot
# (a mesma pasta do package.json). O bot lê ele só na INICIALIZAÇÃO —
# depois de colar as chaves, reinicie (./bot.sh start) e confira com .pools.
REMOVE_BG_KEYS=

# APIs próprias/alternativas de remoção de fundo (POST multipart, campo "image",
# resposta PNG). Separe por vírgula para ter várias de reserva.
REMOVE_BG_URLS=

# Usa o `rembg` local (pip install rembg) como último recurso: true/false
LOCAL_REMBG=false

# ── 🧠 IA (opcional — sem nada configurado usa Pollinations grátis) ──
# Chaves Gemini (aistudio.google.com — grátis): gira entre várias
GEMINI_KEYS=
# Chaves OpenAI
OPENAI_KEYS=
# Chaves Groq (console.groq.com — grátis e rápido)
GROQ_KEYS=
# Qualquer API compatível com OpenAI (OpenRouter, DeepSeek, Ollama…)
AI_BASE_URL=
AI_KEYS=
AI_MODEL=

# ── ⬇️ DOWNLOADS ───────────────────────────────────────────────
# O bot já baixa TikTok, Instagram, Pinterest, YouTube, X, Facebook,
# Threads, Reddit, Twitch e Vimeo SEM configurar nada. As opções abaixo
# só afinam o desempenho.
#
# Instâncias Cobalt (túnel universal para a cauda longa de sites).
# Adicione quantas quiser; o bot gira entre elas e pula as que falharem.
# Lista pública: https://instances.cobalt.best
COBALT_INSTANCES=
# Chave para instância Cobalt PRÓPRIA (auto-hospedada)
COBALT_API_KEY=

# Endpoints alternativos do TikTok (padrão: tikwm.com)
TIKTOK_API=

# yt-dlp local (modo turbo, opcional). No Termux:
#   pip install -U yt-dlp
# Deixe vazio para autodetecção no PATH.
YTDLP_PATH=
# Desliga o yt-dlp mesmo que esteja instalado: true/false
NEXUS_DISABLE_YTDLP=false

# ── AVANÇADO ───────────────────────────────────────────────────
# Força uma versão específica do WhatsApp Web (ex.: 2,3000,1015901307)
WA_VERSION_OVERRIDE=
